# Dominio canónico: https://llaves365.com
# www.llaves365.com, estadia20.com y www.estadia20.com redirigen con 301.
#
# NOTA: este archivo NO se aplica automáticamente en el despliegue (el
# workflow solo publica `public/` y `server.py`). Tras cambiarlo hay que
# copiarlo a /etc/nginx/sites-available/estadia20.conf en el VPS y ejecutar
# `nginx -t && systemctl reload nginx`. Certbot gestiona los bloques :443
# en vivo; las rutas del certificado (--cert-name estadia20.com) cubren los
# cuatro dominios.

server {
    listen 80;
    listen [::]:80;
    server_name www.llaves365.com estadia20.com www.estadia20.com;

    # Certbot conserva el desafío ACME antes de redirigir.
    location /.well-known/acme-challenge/ {
        root /opt/estadia20/public;
    }

    location / {
        return 301 https://llaves365.com$request_uri;
    }
}

# Redirección de los alias también en HTTPS (mismo certificado ampliado con
# --expand que cubre llaves365.com, www y los dominios estadia20).
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.llaves365.com estadia20.com www.estadia20.com;

    ssl_certificate /etc/letsencrypt/live/estadia20.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/estadia20.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://llaves365.com$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name llaves365.com;

    root /opt/estadia20/public;
    index index.html;
    # Una publicación puede subir hasta 15 fotos de 12 MB en una sola petición
    # multipart; el servidor las redimensiona antes de guardarlas.
    client_max_body_size 190m;

    location /api/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        proxy_pass http://127.0.0.1:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # SEO: el sitemap y robots.txt los genera la API con los anuncios
    # publicados; nunca se responde el HTML de la SPA en estas rutas.
    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /robots.txt {
        proxy_pass http://127.0.0.1:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://images.unsplash.com https://lh3.googleusercontent.com; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
        try_files /index.html =404;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://images.unsplash.com https://lh3.googleusercontent.com; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
        try_files $uri $uri/ /index.html;
    }

    location ~ /\. {
        deny all;
    }
}
